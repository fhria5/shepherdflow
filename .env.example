# ShepherdFlow — copy to .env.local (never commit .env.local)
# Leave LLM_API_KEY empty to run in DEMO MODE (prepared sample results, no live AI call).
# Defaults below point at the Verboo router, which is OpenAI-compatible.
# Verboo does NOT support response_format=json_object — the app detects the
# 403 and retries as plain text, then parses JSON from the reply.
LLM_BASE_URL=https://code.verboo.ai/router/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3-flash

# Optional fallback provider (used automatically when the primary fails,
# times out, or returns broken JSON after one retry). Leave a fallback
# variable empty to reuse the matching primary value.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
